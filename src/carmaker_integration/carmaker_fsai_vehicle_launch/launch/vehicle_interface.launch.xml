<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="vehicle_id" default="default"/>
  <arg name="raw_vehicle_cmd_converter_param_path" default="$(find-pkg-share carmaker_fsai_vehicle_launch)/config/raw_vehicle_cmd_converter.param.yaml"/>
  <arg name="initial_engage_state" default="false"/>
  <node pkg="autoware_raw_vehicle_cmd_converter" exec="autoware_raw_vehicle_cmd_converter_node" name="raw_vehicle_cmd_converter" output="screen">
    <param from="$(var raw_vehicle_cmd_converter_param_path)" allow_substs="true"/>
    <remap from="~/input/control_cmd" to="/control/command/control_cmd"/>
    <remap from="~/input/odometry" to="/localization/kinematic_state"/>
    <remap from="~/input/steering" to="/vehicle/status/steering_status"/>
    <remap from="~/input/actuation_status" to="/vehicle/status/actuation_status"/>
    <remap from="~/output/actuation_cmd" to="/control/command/actuation_cmd"/>
    <remap from="~/output/steering_status" to="/vehicle/status/steering_status"/>
  </node>
</launch>

