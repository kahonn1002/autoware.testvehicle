<?xml version="1.0"?>
<package format="3">
  <name>autoware_carmaker_launch</name>
  <version>0.1.0</version>
  <description>End-to-end launch and map tools for CarMaker 15 Formula Student simulation.</description>
  <maintainer email="no@support.com">FSAI</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>autoware_carmaker_interface</exec_depend>
  <exec_depend>autoware_launch</exec_depend>
  <exec_depend>carmaker_fsai_vehicle_description</exec_depend>
  <exec_depend>carmaker_fsai_vehicle_launch</exec_depend>
  <exec_depend>carmaker_sensor_kit_description</exec_depend>
  <exec_depend>carmaker_sensor_kit_launch</exec_depend>
  <exec_depend>carmaker_demo_vehicle_description</exec_depend>
  <exec_depend>carmaker_demo_vehicle_launch</exec_depend>
  <exec_depend>carmaker_demo_sensor_kit_description</exec_depend>
  <exec_depend>carmaker_demo_sensor_kit_launch</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- Routing check of converted TestRun maps; conversion itself also needs CarMaker's IPGRoad wheel. -->
  <exec_depend>lanelet2_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
